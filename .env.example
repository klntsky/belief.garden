# Server Configuration
PORT=3000

# Session Security
SESSION_SECRET=

# Node Environment (development, production, test)
NODE_ENV=development

# Rate Limiting
RATE_LIMIT=3
PROPOSAL_RATE_LIMIT=10

# Pagination
PAGE_SIZE=100

# User Statistics Update Interval (in milliseconds)
UPDATE_USERS_INTERVAL_MS=300000

# OpenAI API Configuration
OPENAI_API_KEY=

# Testing Configuration
TEST_PORT=3001
TEST_PORT_MAX=65535
SITE_DEPLOYMENT_PATH=http://localhost:3001

# Playwright/Browser Testing Configuration
HEADLESS_BROWSER=1
BROWSER_PATH=
